rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function entitlementFields() {
      return [
        'isVip',
        'vip',
        'isPremium',
        'premium',
        'entitlements',
        'subscription',
        'subscriptionStatus'
      ];
    }

    function dailyUsageFields() {
      return [
        'quiz_count',
        'explanation_count',
        'exam_used',
        'updated_at'
      ];
    }

    function validDailyUsageData() {
      return request.resource.data.keys().hasOnly(dailyUsageFields())
        && request.resource.data.updated_at == request.time
        && (!('quiz_count' in request.resource.data)
          || (request.resource.data.quiz_count is int
            && request.resource.data.quiz_count >= 0
            && request.resource.data.quiz_count <= 10000))
        && (!('explanation_count' in request.resource.data)
          || (request.resource.data.explanation_count is int
            && request.resource.data.explanation_count >= 0
            && request.resource.data.explanation_count <= 10))
        && (!('exam_used' in request.resource.data)
          || request.resource.data.exam_used is bool);
    }

    function incrementsByOne(fieldName) {
      return (!request.resource.data.diff(resource.data).affectedKeys().hasAny([fieldName]))
        || (fieldName in request.resource.data
          && ((fieldName in resource.data
            && request.resource.data[fieldName] == resource.data[fieldName] + 1)
            || (!(fieldName in resource.data)
              && request.resource.data[fieldName] == 1)));
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(entitlementFields());

      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(entitlementFields());

      allow delete: if false;

      match /progress/{questionId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'correct_streak',
            'wrong_count',
            'total_attempts',
            'is_mastered',
            'is_favorite',
            'last_practiced'
          ])
          && request.resource.data.correct_streak is int
          && request.resource.data.correct_streak >= 0
          && request.resource.data.correct_streak <= 10000
          && request.resource.data.wrong_count is int
          && request.resource.data.wrong_count >= 0
          && request.resource.data.wrong_count <= 10000
          && request.resource.data.total_attempts is int
          && request.resource.data.total_attempts >= 0
          && request.resource.data.total_attempts <= 10000
          && request.resource.data.is_mastered is bool
          && request.resource.data.is_favorite is bool
          && (!('last_practiced' in request.resource.data)
            || request.resource.data.last_practiced is timestamp);

        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'correct_streak',
            'wrong_count',
            'total_attempts',
            'is_mastered',
            'is_favorite',
            'last_practiced'
          ])
          && (!('correct_streak' in request.resource.data)
            || (request.resource.data.correct_streak is int
              && request.resource.data.correct_streak >= 0
              && request.resource.data.correct_streak <= 10000))
          && (!('wrong_count' in request.resource.data)
            || (request.resource.data.wrong_count is int
              && request.resource.data.wrong_count >= 0
              && request.resource.data.wrong_count <= 10000))
          && (!('total_attempts' in request.resource.data)
            || (request.resource.data.total_attempts is int
              && request.resource.data.total_attempts >= 0
              && request.resource.data.total_attempts <= 10000))
          && (!('is_mastered' in request.resource.data)
            || request.resource.data.is_mastered is bool)
          && (!('is_favorite' in request.resource.data)
            || request.resource.data.is_favorite is bool)
          && (!('last_practiced' in request.resource.data)
            || request.resource.data.last_practiced is timestamp);

        allow delete: if isOwner(uid);
      }

      match /daily_usage/{dateId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && dateId.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && validDailyUsageData()
          && (('quiz_count' in request.resource.data
              && request.resource.data.quiz_count == 1)
            || ('explanation_count' in request.resource.data
              && request.resource.data.explanation_count == 1)
            || ('exam_used' in request.resource.data
              && request.resource.data.exam_used == true));

        allow update: if isOwner(uid)
          && dateId.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(dailyUsageFields())
          && validDailyUsageData()
          && incrementsByOne('quiz_count')
          && incrementsByOne('explanation_count')
          && (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['exam_used'])
            || request.resource.data.exam_used == true);

        allow delete: if isOwner(uid);
      }

      match /exam_history/{attemptId} {
        allow read: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'attempt_id',
            'completed_at_ms',
            'total_questions',
            'correct_count',
            'wrong_count',
            'time_used_seconds',
            'passed',
            'question_ids',
            'selected_answers'
          ])
          && request.resource.data.attempt_id == attemptId
          && request.resource.data.completed_at_ms is int
          && request.resource.data.completed_at_ms > 0
          && request.resource.data.total_questions == 30
          && request.resource.data.correct_count is int
          && request.resource.data.correct_count >= 0
          && request.resource.data.correct_count <= 30
          && request.resource.data.wrong_count is int
          && request.resource.data.wrong_count >= 0
          && request.resource.data.wrong_count <= 30
          && request.resource.data.correct_count
            + request.resource.data.wrong_count == 30
          && request.resource.data.time_used_seconds is int
          && request.resource.data.time_used_seconds >= 0
          && request.resource.data.time_used_seconds <= 1200
          && request.resource.data.passed is bool
          && request.resource.data.question_ids is list
          && request.resource.data.question_ids.size() == 30
          && request.resource.data.selected_answers is map;

        allow delete: if isOwner(uid);
      }

      match /exam_sessions/{sessionId} {
        allow read: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && sessionId == 'current'
          && request.resource.data.keys().hasOnly([
            'updated_at_ms',
            'session'
          ])
          && request.resource.data.updated_at_ms is int
          && request.resource.data.updated_at_ms > 0
          && request.resource.data.session is map
          && request.resource.data.session.keys().hasOnly([
            'schema_version',
            'data_version',
            'actor_id',
            'random_seed',
            'question_ids',
            'selected_answers',
            'started_at_ms',
            'deadline_ms',
            'current_index',
            'submitted_at_ms'
          ])
          && request.resource.data.session.schema_version == 1
          && request.resource.data.session.actor_id == uid
          && request.resource.data.session.question_ids is list
          && request.resource.data.session.question_ids.size() == 30
          && request.resource.data.session.selected_answers is map
          && request.resource.data.session.current_index is int
          && request.resource.data.session.current_index >= 0
          && request.resource.data.session.current_index < 30;

        allow delete: if isOwner(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
