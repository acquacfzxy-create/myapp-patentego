{
  "functions": [{
    "source": "functions",
    "codebase": "subscriptions",
    "ignore": ["node_modules", "*.log", "test"],
    "predeploy": ["node --test \"$RESOURCE_DIR/test/subscription_policy.test.js\""]
  }],
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "assets/assets/italy_quiz.db",
      "assets/assets/fonts/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "/flutter_bootstrap.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/assets/web/questions/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=3600,must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/images/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/main.dart.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "italy-patente-b",
          "appId": "1:744398794890:android:073ea3e7d62ae88f4a7d73",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "italy-patente-b",
          "appId": "1:744398794890:ios:c8531295333900034a7d73",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "macos": {
        "default": {
          "projectId": "italy-patente-b",
          "appId": "1:744398794890:ios:c8531295333900034a7d73",
          "uploadDebugSymbols": false,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "italy-patente-b",
          "configurations": {
            "android": "1:744398794890:android:073ea3e7d62ae88f4a7d73",
            "ios": "1:744398794890:ios:c8531295333900034a7d73",
            "macos": "1:744398794890:ios:c8531295333900034a7d73",
            "web": "1:744398794890:web:96462833fa68cd014a7d73"
          }
        }
      }
    }
  }
}
